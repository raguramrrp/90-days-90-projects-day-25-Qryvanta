# QRYVANTA Environment Configuration
# Copy this file to .env and update values before running in production.

APP_NAME=QRYVANTA
APP_ENV=development
DEBUG=true

# Database URL
# Default: SQLite local fallback for frictionless Windows development.
# For PostgreSQL, uncomment and update:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/qryvanta
DATABASE_URL=sqlite:///./qryvanta.db

# Security (CHANGE THIS IN PRODUCTION!)
JWT_SECRET_KEY=change-this-development-secret-key-before-deployment-qryvanta-32bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Uploads
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_MB=5

# Machine Learning & Routing Thresholds (configurable in Settings UI)
HIGH_CONFIDENCE_THRESHOLD=0.80
MEDIUM_CONFIDENCE_THRESHOLD=0.55
SIMILARITY_THRESHOLD=0.25

# Frontend API base URL (used by Vite)
VITE_API_URL=http://127.0.0.1:8000
